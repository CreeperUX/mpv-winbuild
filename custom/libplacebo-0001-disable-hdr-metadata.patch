From e5dd3aeed435117c1b2f23f62987de78abad12e3 Mon Sep 17 00:00:00 2001
From: CreeperUX <CreeperUX@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:25:38 +0200
Subject: [PATCH] d3d11/swapchain: add option to not set HDR10 swapchain
 metadata

Add `pl_d3d11_swapchain_params.disable_hdr_metadata`. When set, the HDR
color space is still configured, but IDXGISwapChain4::SetHDRMetaData is
always called with DXGI_HDR_METADATA_TYPE_NONE.

Microsoft no longer recommends that applications set this metadata, and
with Windows' "Use Dolby Vision mode" enabled it makes the display switch
from Dolby Vision to HDR10 signalling (an HDMI re-sync) whenever HDR output
starts.
---
 src/d3d11/swapchain.c          | 9 ++++++---
 src/include/libplacebo/d3d11.h | 9 +++++++++
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/src/d3d11/swapchain.c b/src/d3d11/swapchain.c
index 3323704..1f717b6 100644
--- a/src/d3d11/swapchain.c
+++ b/src/d3d11/swapchain.c
@@ -204,11 +204,13 @@ static DXGI_HDR_METADATA_HDR10 set_hdr10_metadata(const struct pl_hdr_metadata *
 
 static bool set_swapchain_metadata(struct d3d11_ctx *ctx,
                                    IDXGISwapChain3 *swapchain3,
-                                   struct d3d11_csp_mapping *csp_map)
+                                   struct d3d11_csp_mapping *csp_map,
+                                   bool disable_hdr_metadata)
 {
     IDXGISwapChain4 *swapchain4 = NULL;
     bool ret = false;
-    bool is_hdr = pl_color_transfer_is_hdr(csp_map->out_csp.transfer);
+    bool is_hdr = pl_color_transfer_is_hdr(csp_map->out_csp.transfer) &&
+                  !disable_hdr_metadata;
     DXGI_HDR_METADATA_HDR10 hdr10 = is_hdr ?
         set_hdr10_metadata(&csp_map->out_csp.hdr) : (DXGI_HDR_METADATA_HDR10){ 0 };
 
@@ -419,7 +421,8 @@ static void update_swapchain_color_config(pl_swapchain sw,
     if (!swapchain3)
         goto cleanup;
 
-    if (!set_swapchain_metadata(ctx, swapchain3, &p->csp_map))
+    if (!set_swapchain_metadata(ctx, swapchain3, &p->csp_map,
+                                p->params.disable_hdr_metadata))
         p->csp_map = old_map;
 
     pl_d3d11_flush_message_queue(ctx, "After colorspace hint");
diff --git a/src/include/libplacebo/d3d11.h b/src/include/libplacebo/d3d11.h
index c4fa958..c9f0e7b 100644
--- a/src/include/libplacebo/d3d11.h
+++ b/src/include/libplacebo/d3d11.h
@@ -209,6 +209,15 @@ struct pl_d3d11_swapchain_params {
     // be used to prefer formats with higher color bit depth. This is a hint,
     // if no matching format is found, lower bit depths will be accepted.
     uint8_t color_bits;
+
+    // If set, libplacebo will not attach HDR10 static metadata to the
+    // swapchain (IDXGISwapChain4::SetHDRMetaData is always called with
+    // DXGI_HDR_METADATA_TYPE_NONE), while still setting the HDR color space.
+    // Microsoft no longer recommends that apps set this metadata, and on some
+    // configurations (e.g. Windows "Dolby Vision mode") it makes the display
+    // switch output modes and re-sync whenever HDR output starts. Content
+    // should then be tone mapped to the display's capabilities by the caller.
+    bool disable_hdr_metadata;
 };
 
 #define pl_d3d11_swapchain_params(...) (&(struct pl_d3d11_swapchain_params) { __VA_ARGS__ })
-- 
2.54.0.windows.1

